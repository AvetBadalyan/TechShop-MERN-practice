# ─── Backend (Vercel: "backend/API" project env vars) ───────────────────────
NODE_ENV=development
PORT=5000
MONGO_URL=<your_mongo_db_uri>
JWT_SECRET=<your_secret>
PAYPAL_CLIENT_ID=<your_paypal_client_id>
PAYPAL_APP_SECRET=<your_paypal_secret>
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAGINATION_LIMIT=8

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# Read-only demo admin: this account can view admin screens but cannot
# modify data. Defaults to avet@gmail.com if unset.
DEMO_ADMIN_EMAIL=avet@gmail.com

# Owner (full admin) account created by the seeder. Keep the real password
# out of the repo by setting these here / in the host's env settings.
OWNER_ADMIN_EMAIL=<your_admin_email>
OWNER_ADMIN_PASSWORD=<your_admin_password>

# Allowed browser origin(s) for CORS, comma-separated, no trailing slash.
# In production set this to the frontend's Vercel URL, e.g.
# CLIENT_URL=https://avets-techshop.vercel.app
CLIENT_URL=http://localhost:3000

# ─── Frontend (Vercel: "frontend" project env var) ──────────────────────────
# Full URL of the deployed API. Leave empty locally to use the Vite dev proxy.
# In production, e.g. VITE_API_URL=https://avets-techshop-api.vercel.app
VITE_API_URL=
