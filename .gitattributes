# Normalize line endings: treat as text and store as LF in the repo.
# This prevents phantom "modified" files when copying between drives/OSes.
* text=auto eol=lf

# Explicit text files
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.env  text eol=lf

# Binary files: never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
